# Optional: the dev setup works with the relative /api proxy and needs NO env vars.
# If you ever need to point the client at a remote API directly, set:
# VITE_API_URL=http://localhost:5000
# If the API has API_KEY set, the browser must send it (Vite bakes it into the
# build, so only use a key you are willing to expose to app users):
# VITE_API_KEY=your-api-key
